# StrawSync Environment Configuration
# Copy this file to `.env.local` for local development and set these values in Vercel for production.
# NEVER commit `.env.local` or real credentials to Git.

# 1. Neon PostgreSQL Connection String (Required for persistent cloud database & server auth)
DATABASE_URL=

# 2. HTTP-only JWT Session Signing Secret (generate a strong random string for production)
AUTH_SECRET=

# 3. Canonical App Origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Optional Live LLM Keys for Voice AI Copilot (at least one enables live LLM; built-in NLU runs automatically if omitted)
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# 5. Optional Legacy Supabase Credentials (fallback only when DATABASE_URL is unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
