# StrawSync Environment Configuration
# Copy this file to `.env.local` for local development and set these values in Vercel for production.
# NEVER commit `.env.local` or real credentials to Git.

# 1. Supabase Project Credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias supported by newer Supabase projects (Publishable key):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 2. Canonical App Origin (used for email verification & password reset redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3. SERVER-ONLY Admin Secret (NEVER prefix with NEXT_PUBLIC_ and NEVER expose in browser code)
# Only needed if running server-side scripts or admin bootstrap outside SQL Editor.
SUPABASE_SERVICE_ROLE_KEY=
