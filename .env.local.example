# StrawSync Environment Configuration Example
# Copy this file to .env.local and populate with your Supabase credentials:

# Supabase PostgreSQL & Auth Credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer Supabase publishable key alias:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical App URL (e.g. http://localhost:3000 locally or https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY (do NOT expose to client code or commit real keys)
# SUPABASE_SERVICE_ROLE_KEY=
